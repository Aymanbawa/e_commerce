# D1 is a Cloudflare binding, not a connection string. Configure wrangler.jsonc.
# For local development copy this file to .dev.vars (never commit .dev.vars).
# Optional external Python model; HTTPS endpoint ending in /recommendations.
ML_API_URL=
ML_API_TOKEN=
# No session signing secret is needed: sessions use random 256-bit opaque tokens.
# Admin access is granted only via an explicit D1 role update; never via public signup.
